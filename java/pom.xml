<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.pulsegraph</groupId>
  <artifactId>pulsegraph-java</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>PulseGraph Java</name>
  <description>Spring Boot microservices fork of PulseGraph</description>

  <modules>
    <module>libs/common</module>
    <module>libs/melt</module>
    <module>libs/kafka</module>
    <module>libs/contextgraph</module>
    <module>libs/snapshot</module>
    <module>libs/compliance</module>
    <module>libs/warroom</module>
    <module>services/adapter-otel</module>
    <module>services/adapter-datadog</module>
    <module>services/adapter-newrelic</module>
    <module>services/adapter-dynatrace</module>
    <module>services/ingest-gateway</module>
    <module>services/normalizer</module>
    <module>services/correlator</module>
    <module>services/topology-builder</module>
    <module>services/snapshotter</module>
    <module>services/rca-engine</module>
    <module>services/query-api</module>
    <module>services/compliance-guardian</module>
    <module>services/war-room</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <spring-boot.version>3.3.5</spring-boot.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.pulsegraph</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.pulsegraph</groupId>
        <artifactId>melt</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.pulsegraph</groupId>
        <artifactId>kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.pulsegraph</groupId>
        <artifactId>contextgraph</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.pulsegraph</groupId>
        <artifactId>snapshot</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.pulsegraph</groupId>
        <artifactId>compliance</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.pulsegraph</groupId>
        <artifactId>warroom</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
