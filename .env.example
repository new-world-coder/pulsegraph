# ─── PulseGraph Local Environment Template ─────────────────────
# Copy this file to .env and adjust values for your local setup.
# DO NOT commit .env to version control.

# ── Postgres ────────────────────────────────────────────────────
POSTGRES_DB=pulsegraph
POSTGRES_USER=pulsegraph
POSTGRES_PASSWORD=pulsegraph
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── ClickHouse ──────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=pulsegraph
CLICKHOUSE_USER=pulsegraph
CLICKHOUSE_PASSWORD=pulsegraph

# ── OpenSearch ──────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ── Redpanda / Kafka ────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── MinIO ────────────────────────────────────────────────────────
MINIO_ROOT_USER=pulsegraph
MINIO_ROOT_PASSWORD=pulsegraph123
MINIO_ENDPOINT=http://localhost:9001
MINIO_SNAPSHOTS_BUCKET=snapshots
MINIO_MODELS_BUCKET=models

# ── Service Ports ────────────────────────────────────────────────
INGEST_GATEWAY_PORT=8081
API_GATEWAY_PORT=8088
QUERY_API_PORT=8090
RCA_ENGINE_PORT=8095
# Set true only when testing auth stubs locally
# API_GATEWAY_AUTH_REQUIRED=false

# ── Telemetry / Auth (placeholder) ──────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
